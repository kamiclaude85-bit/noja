{
  "manifest_version": 3,
  "name": "نوجا — جستجوگر خودرو در دیوار",
  "short_name": "Noja",
  "version": "0.1.0",
  "description": "همهٔ آگهی‌های یک خودروی مشخص را در دیوار پیدا می‌کند، شخصی و نمایشگاهی را جدا می‌کند و مشخصات را کنار هم نشان می‌دهد.",
  "permissions": ["storage", "tabs", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://divar.ir/*", "https://api.divar.ir/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "نوجا",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://divar.ir/*"],
      "js": ["src/parser.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
