# Radyab online panel
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always HTTPS (sign-in cookies and the bot key travel only encrypted).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Every /api/... address goes to api.php
  RewriteRule ^api/(.*)$ api.php?p=$1 [QSA,L]
  # Private parts are never served
  RewriteRule ^(lib|data)(/|$) - [F,L]
  RewriteRule ^(config\.php|cron\.php)$ - [F,L]
</IfModule>

# The bot key header must reach PHP on some hosts
SetEnvIf X-Radyab-Key "(.*)" HTTP_X_RADYAB_KEY=$1

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header set X-Frame-Options "DENY"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
